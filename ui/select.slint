import { Theme } from "theme.slint";
import { KeyAction } from "backend.slint";
import { FocusRing } from "focus-ring.slint";

// Caixa de seleção no tema do app: campo com prefixo (lado do fone) e lista em popup.
export component Select inherits Rectangle {
    in property <[KeyAction]> model;
    in property <int> current-value: -1;
    in property <string> prefix;
    callback activated(int);   // valor (value) da opção escolhida
    preferred-height: Theme.control;
    border-radius: Theme.radius-sm;
    background: ta.pressed ? Theme.surface-press : (ta.has-hover ? Theme.surface-hi : Theme.bg);
    border-width: 1px;
    border-color: popup.is-open ? Theme.accent : Theme.edge-light;
    animate background { duration: Theme.d(Theme.fast); }

    fs := FocusScope {
        // O anel de foco só aparece na navegação por teclado, nunca depois de um clique.
        property <bool> kb: false;
        focus-gained(reason) => { self.kb = reason == FocusReason.tab-navigation; }
        focus-lost(reason) => { self.kb = false; }
        key-pressed(e) => {
            if (e.text == " " || e.text == Key.Return) {
                popup.show();
                return accept;
            }
            return reject;
        }
    }
    if root.prefix != "": Text {
        x: Theme.s3;
        y: (parent.height - self.height) / 2;
        text: root.prefix;
        font-family: Theme.family;
        font-size: Theme.size-label;
        font-weight: 600;
        color: Theme.accent;
    }
    for m in root.model: Text {
        visible: m.value == root.current-value;
        x: Theme.s3 + (root.prefix != "" ? 16px : 0px);
        width: root.width - self.x - 28px;
        y: (parent.height - self.height) / 2;
        text: m.label;
        overflow: elide;
        font-family: Theme.family;
        font-size: Theme.size-body;
        color: Theme.text;
    }
    Text {
        x: root.width - self.width - Theme.s2;
        y: (parent.height - self.height) / 2;
        text: popup.is-open ? "⌃" : "⌄";
        font-family: Theme.family;
        font-size: 16px;
        color: Theme.text2;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            fs.focus();
            popup.show();
        }
    }
    FocusRing { show: fs.has-focus && fs.kb; r: Theme.radius-sm; w: parent.width; h: parent.height; }

    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: root.width;
        height: Math.min(root.model.length * 34px + 8px, 320px);
        close-policy: PopupClosePolicy.close-on-click-outside;
        Rectangle {
            border-radius: Theme.radius-sm;
            background: Theme.surface-hi;
            border-width: 1px;
            border-color: Theme.edge-light;
        }
        Flickable {
            x: 4px;
            y: 4px;
            width: parent.width - 8px;
            height: parent.height - 8px;
            content-height: root.model.length * 34px;
            for m[i] in root.model: Rectangle {
                y: i * 34px;
                height: 34px;
                border-radius: Theme.radius-sm - 2px;
                background: item-ta.has-hover ? Theme.surface-hi.brighter(0.2) : transparent;
                Text {
                    x: Theme.s3;
                    y: (parent.height - self.height) / 2;
                    text: m.label;
                    font-family: Theme.family;
                    font-size: Theme.size-body;
                    color: m.value == root.current-value ? Theme.accent : Theme.text;
                }
                item-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        popup.close();
                        root.activated(m.value);
                    }
                }
            }
        }
    }
}
