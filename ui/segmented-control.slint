import { Theme } from "theme.slint";
import { FocusRing } from "focus-ring.slint";

// Controle segmentado: a pílula desliza até a opção ativa.
// Setas esquerda/direita mudam a opção pelo teclado.
export component SegmentedControl inherits Rectangle {
    in property <[string]> options;
    in property <int> current: -1;
    callback picked(int);
    preferred-height: Theme.control;
    property <length> seg-w: options.length > 0 ? (self.width - 6px) / options.length : 0px;

    fs := FocusScope {
        // O anel de foco só aparece na navegação por teclado, nunca depois de um clique.
        property <bool> kb: false;
        focus-gained(reason) => { self.kb = reason == FocusReason.tab-navigation; }
        focus-lost(reason) => { self.kb = false; }
        key-pressed(e) => {
            if (e.text == Key.LeftArrow) {
                if (root.current > 0) { root.picked(root.current - 1); }
                return accept;
            }
            if (e.text == Key.RightArrow) {
                if (root.current < root.options.length - 1) { root.picked(root.current + 1); }
                return accept;
            }
            return reject;
        }
    }
    track := Rectangle {
        border-radius: Theme.radius-sm + 2px;
        background: Theme.bg;
        border-width: 1px;
        border-color: Theme.hairline;

        pill := Rectangle {
            y: 3px;
            height: parent.height - 6px;
            width: root.seg-w;
            border-radius: Theme.radius-sm;
            visible: root.current >= 0;
            background: Theme.pill;
            x: 3px + Math.max(root.current, 0) * root.seg-w;
            animate x { duration: Theme.m(260ms); easing: Theme.out-cubic; }
        }
        for opt[i] in root.options: Rectangle {
            x: 3px + i * root.seg-w;
            y: 3px;
            width: root.seg-w;
            height: parent.height - 6px;
            Text {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                text: opt;
                font-family: Theme.family;
                font-size: Theme.size-body;
                font-weight: i == root.current ? 600 : 500;
                color: i == root.current ? Theme.accent : (ta.has-hover ? Theme.text : Theme.text2);
                animate color { duration: Theme.d(Theme.fast); }
            }
            ta := TouchArea {
                mouse-cursor: pointer;
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) { fs.focus(); }
                }
                clicked => { root.picked(i); }
            }
        }
    }
    FocusRing { show: fs.has-focus && fs.kb; r: Theme.radius-sm + 2px; w: parent.width; h: parent.height; }
}
